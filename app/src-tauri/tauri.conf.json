{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SupaDashboard",
  "version": "0.2.2",
  "identifier": "dev.supadashboard.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SupaDashboard",
        "width": 770,
        "height": 392,
        "maximizable": false,
        "focus": false,
        "focusable": false,
        "noRedirectionBitmap": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows",
        "visible": false,
        "label": "main",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": {
        "connect-src": "'self' ipc: http://ipc.localhost http://plugin.localhost",
        "frame-src": "https: http://localhost:*",
        "img-src": "'self' http://asset.localhost https: http: data:",
        "media-src": "'self' http://asset.localhost https: http:",
        "script-src": "'self' http://plugin.localhost"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MzlGNTAyMURERUQzNjQKUldSazA5NGRBdlU1eUlmRVoxVlU3eTY1SUZkNVhtYjhCRjFxd1NrOHVrZmo5a3VWb25qTzN4dHgK",
      "endpoints": ["https://github.com/McFck/SupaDashboard/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": { "nsis": { "installMode": "currentUser" } },
    "fileAssociations": [
      {
        "ext": ["sdplugin"],
        "name": "SupaDashboard plugin",
        "description": "SupaDashboard plugin",
        "role": "Viewer"
      }
    ],
    "resources": {
      "THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
