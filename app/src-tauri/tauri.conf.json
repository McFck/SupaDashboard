{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SupaDashboard",
  "version": "0.1.0",
  "identifier": "dev.supadashboard.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "SupaDashboard",
        "width": 770,
        "height": 392,
        "maximizable": false,
        "focus": false,
        "focusable": false,
        "noRedirectionBitmap": true,
        "visible": false,
        "label": "main",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": [] },
      "csp": {
        "frame-src": "https: http://localhost:*",
        "img-src": "'self' http://asset.localhost https: http: data:",
        "media-src": "'self' http://asset.localhost https: http:"
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": ["THIRD-PARTY-NOTICES.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
