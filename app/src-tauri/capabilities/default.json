{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions both windows share",
  "windows": ["main", "panel"],
  "permissions": [
    "core:default",
    "store:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "spotify:*" }]
    }
  ]
}
